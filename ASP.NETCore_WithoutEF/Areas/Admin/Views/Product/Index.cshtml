@{
    ViewData["Title"] = "Products";
}

<div class="row justify-content-center">
    <div class="container col-10">
        <div class="row pt-4">
            <div class="col-6">
                <h3 class="text-primary">Product CRUD</h3>
            </div>
            <div class="col-6 text-end">
                <button type="button" class="btn btn-primary btn-new-product">
                    <i class="bi bi-plus-circle"></i> Create New
                </button>
            </div>
        </div>

        <table class="table table-striped table-bordered" id="productsTable">
            <thead>
                <tr>
                    <th>Product Name</th>
                    <th>Category</th>
                    <th>Price($)</th>
                    <th>Discount Price</th>
                    <th>Added Date</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
            </tbody>

        </table>
    </div>
</div>



<!-- Modal -->

<div class="modal fade" id="productModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" enctype="multipart/form-data">

    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Product Modal</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body" formenctype="multipart/form-data">
                
                <div class="mb-3">
                    <label class="form-label">Product Name</label>
                    <input type="text" class="form-control" id="txtName" autocomplete="off">
                </div>
                <div class="mb-3">
                    <label class="form-label">Product Number</label>
                    <input type="text" class="form-control" id="txtProductNum">
                </div> 
                <div class="mb-3">
                    <label class="form-label">Originated</label>
                    <input type="text" class="form-control" id="txtOrigin">
                </div>
               
                <div class="mb-3">
                    <label class="form-label">Category</label>
                    <select class="form-select" id="selectCategory"></select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Product Detail</label>
                    <input type="text" class="form-control" id="txtDetail">
                </div>
                <div class="mb-3">
                    <label class="form-label">Price</label>
                    <input type="number" class="form-control" id="numPrice">
                </div>
                <div class="mb-3">
                    <label class="form-label">Price 50</label>
                    <input type="number" class="form-control" id="numPrice50">
                </div>
                <div class="mb-3">
                    <label class="form-label">Price 100</label>
                    <input type="number" class="form-control" id="numPrice100">
                </div>
               
                <div class="mb-3">
                    <label class="form-label">Discount Price</label>
                    <input type="number" class="form-control" id="numDiscount">
                </div>
                <div class="mb-3">
                    <label class="form-label">Added Date</label>
                    <input type="text" class="form-control" id="txtDate">
                </div>
                <div class="mb-3">                    
                    <label class="form-label">Image Url</label>                   
                    <input type="file" class="form-control" id="imageFile" name="ImageFile" accept="image/*">
                    <input type="hidden" id="hiddenImageUrl" class="form-control" />
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary btn-save-changes">Save changes</button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/product.js"></script>
}

