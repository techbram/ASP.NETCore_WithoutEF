@using App.Models.ViewModel
@model RegisterVM

@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<div class=" card shadow border-0 mt-4">
    <div class="card header bg-primary bg-gradient ml-0 py-4">
        <div class=" row">
            <div class="col-12 text-center">
                @* <h2 class="py-2 text-white">Register</h2> *@
                @if (HttpContextAccessor.HttpContext.Session.GetString("RoleName") == SD.Role_Admin)
                {
                    <h2 class="py-2 text-white">Register - ADMIN PORTAL</h2>
                }
                else
                {
                    <h2 class="py-2 text-white">Register</h2>
                }
            </div>
        </div>
    </div>
    <div class="card body p-4">
        <div class="row pt-3">
            <div class="col-md-12">
                <form id="registerForm" class="row" method="post">
                    
                    <h3 class="border-bottom pb-3 mb-4 text-secondary text-center">Create a new account.</h3>

                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <div class="form-floating mb-3 col-md-12">
                        <input asp-for="@Model.User.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="@Model.User.Email" class="ms-2 text-muted">Email</label>
                        <span asp-validation-for="@Model.User.Email" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3 col-md-6">
                        <input asp-for="@Model.User.PasswordHash" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                        <label asp-for="@Model.User.PasswordHash" class="ms-2 text-muted">Password</label>
                        <span asp-validation-for="@Model.User.PasswordHash" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3 col-md-6">
                        <input asp-for="@Model.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                        <label asp-for="@Model.ConfirmPassword" class="ms-2 text-muted">Confirm Password</label>
                        <span asp-validation-for="@Model.ConfirmPassword" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3 col-md-6">
                        <input asp-for="@Model.User.Name" class="form-control" placeholder="name@example.com" />
                        <label asp-for="@Model.User.Name" class="ms-2 text-muted">Full Name</label>
                        <span asp-validation-for="@Model.User.Name" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3 col-md-6">
                        <input asp-for="@Model.User.StreetAddress" class="form-control" placeholder="name@example.com" />
                        <label asp-for="@Model.User.StreetAddress" class="ms-2 text-muted">StreetAddress</label>
                        <span asp-validation-for="@Model.User.StreetAddress" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3 col-md-6">
                        <input asp-for="@Model.User.City" class="form-control" placeholder="name@example.com" />
                        <label asp-for="@Model.User.City" class="ms-2 text-muted">City</label>
                        <span asp-validation-for="@Model.User.City" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3 col-md-6">
                        <input asp-for="@Model.User.State" class="form-control" placeholder="name@example.com" />
                        <label asp-for="@Model.User.State" class="ms-2 text-muted">State</label>
                        <span asp-validation-for="@Model.User.State" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3 col-md-6">
                        <input asp-for="@Model.User.PostalCode" class="form-control" placeholder="name@example.com" />
                        <label asp-for="@Model.User.PostalCode" class="ms-2 text-muted">PostalCode</label>
                        <span asp-validation-for="@Model.User.PostalCode" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3 col-md-6">
                        <input asp-for="@Model.User.PhoneNumber" class="form-control" placeholder="name@example.com" />
                        <label asp-for="@Model.User.PhoneNumber" class="ms-2 text-muted">PhoneNumber</label>
                        <span asp-validation-for="@Model.User.PhoneNumber" class="text-danger"></span>
                    </div>    
                   @if (HttpContextAccessor.HttpContext.Session.GetString("RoleName") == SD.Role_Admin)
                    {
                        <div class="form-floating mb-3 col-md-6">
                            <select asp-for="@Model.User.RoleId" asp-items="Model.RoleList" class="form-select">
                                <option value="">-- Select Role --</option>
                            </select>
                        </div> 
                        <div class="form-floating mb-3 col-md-6">
                            <select asp-for="@Model.User.CompanyId" style="display:none;" asp-items="Model.CompanyList" class="form-select">
                                <option value="">-- Select Company --</option>
                            </select>
                        </div>
                    }
                    <div class="col-12">
                        <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Register</button>
                    </div>
                </form>
            </div>
           @*  <div class="col-md12 p-3 text-center">
                <section>
                    <p class="divider-text d-flex pt-3">or</p>

                    @{
                        if ((Model.ExternalLogins?.Count ?? 0) == 0)
                        {
                            <div>
                                <p>
                                    There are no external authentication services configured. See this <a href="https://go.microsoft.com/fwlink/?LinkID=532715">
                                        article
                                        about setting up this ASP.NET application to support logging in via external services
                                    </a>.
                                </p>
                            </div>
                        }
                        else
                        {
                            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
                                <div>
                                    <p>
                                        @foreach (var provider in Model.ExternalLogins!)
                                        {
                                            <button type="submit" class="btn btn-primary" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">@provider.DisplayName</button>
                                        }
                                    </p>
                                </div>
                            </form>
                        }
                    }
                </section>
            </div> *@
            
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $('#User_RoleId').change(function () {
                var selection = $('#User_RoleId Option:Selected').text();
                if (selection == 'Company') {
                    $('#User_CompanyId').show();
                }
                else {
                    $('#User_CompanyId').hide();
                }
            })
        })
    </script>
}